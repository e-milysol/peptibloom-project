---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description: string;
}

const { title = 'PeptiBloom', description } = Astro.props;
const pageTitle = title === 'PeptiBloom' ? title : `${title} — PeptiBloom`;
const brandLogoUrl = 'https://peptibloomproject.com/brand/logo.png';
const isCalculatorPage = Astro.url.pathname.startsWith('/calculator/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FCFAFB" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={brandLogoUrl} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="PeptiBloom — Science, Longevity, Wellness" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={brandLogoUrl} />
    <meta name="twitter:image:alt" content="PeptiBloom — Science, Longevity, Wellness" />
    {isCalculatorPage && <link rel="stylesheet" href="/calculator-enhancements.css" />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    {isCalculatorPage && <script is:inline type="module" src="/calculator-enhancements.js"></script>}
  </body>
</html>
