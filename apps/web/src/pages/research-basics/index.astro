---
import BaseLayout from '../../layouts/BaseLayout.astro';

const clusters = [
  {
    title: 'Analítica y documentación',
    description: 'Cómo leer números, certificados, métodos y etiquetas sin sacar conclusiones que los datos no sostienen.',
    articles: [
      ['¿Qué significa LOT, lote o batch en una etiqueta?', '/research-basics/que-significa-lote-lot-batch/', 'Etiquetado · ~3 min'],
      ['Fecha de fabricación, caducidad y retest: ¿qué diferencia hay?', '/research-basics/fabricacion-caducidad-retest-fechas/', 'Estabilidad · ~3 min'],
      ['¿Qué significa “mg por vial” en una etiqueta?', '/research-basics/que-significa-mg-por-vial/', 'Unidades · ~3 min'],
      ['¿Qué significa “For Research Use Only” (RUO)?', '/research-basics/que-significa-research-use-only-ruo/', 'Regulación · ~3 min'],
      ['Precisión y exactitud: ¿son lo mismo?', '/research-basics/precision-exactitud-diferencia/', 'Metrología · ~3 min'],
      ['¿Qué significa la incertidumbre de una medición?', '/research-basics/incertidumbre-medicion-que-significa/', 'Metrología · ~3 min'],
      ['LOD y LOQ: detectar no es lo mismo que cuantificar', '/research-basics/limite-deteccion-cuantificacion-lod-loq/', 'Análisis · ~3 min'],
      ['Especificación, criterio de aceptación y resultado', '/research-basics/especificacion-criterio-aceptacion-resultado/', 'Calidad · ~3 min'],
      ['Identidad, pureza y cantidad: tres preguntas diferentes', '/research-basics/identidad-pureza-cantidad-no-son-lo-mismo/', 'Analítica · ~3 min'],
      ['¿Un HPLC de 99 % significa 99 % de péptido?', '/research-basics/hplc-99-que-significa/', 'HPLC · ~3 min'],
      ['HPLC vs LC-MS: ¿qué diferencia hay?', '/research-basics/hplc-vs-lc-ms/', 'Analítica · ~3 min'],
      ['Impurezas, degradación y agregados: ¿son lo mismo?', '/research-basics/impurezas-degradacion-agregados-peptidos/', 'Analítica · ~3 min'],
      ['¿Qué es un COA y qué nos dice realmente?', '/research-basics/que-es-un-coa/', 'Documentación · ~2 min'],
      ['Cómo leer un COA sin perderse', '/research-basics/como-leer-un-coa/', 'Documentación · ~2 min'],
      ['¿Un COA me da 100 % de seguridad?', '/research-basics/coa-100-seguridad/', 'Documentación · ~2 min'],
      ['¿Qué es la espectrometría de masas?', '/research-basics/que-es-espectrometria-de-masas/', 'Análisis · ~2 min'],
      ['Cómo verificar un COA y quién puede analizar una muestra en Europa', '/research-basics/como-verificar-coa-laboratorios-europa/', 'Verificación · ~3 min'],
    ],
  },
  {
    title: 'Conservación y cadena de frío',
    description: 'Qué significan realmente los rangos térmicos y por qué una excursión necesita datos, no reglas virales.',
    articles: [
      ['¿Qué significa conservar entre 2 y 8 °C?', '/research-basics/que-significa-conservar-2-8-c/', 'Cadena de frío · ~3 min'],
      ['¿Qué es una excursión de temperatura?', '/research-basics/excursion-temperatura-que-significa/', 'Estabilidad · ~3 min'],
      ['“Temperatura ambiente” y controlled room temperature', '/research-basics/temperatura-ambiente-controlled-room-temperature/', 'Terminología · ~3 min'],
      ['¿Qué es realmente la cadena de frío?', '/research-basics/cadena-frio-que-es-como-se-controla/', 'Logística · ~3 min'],
      ['¿Qué puede degradar un péptido?', '/research-basics/que-degrada-peptidos-temperatura-luz-humedad-oxidacion-agitacion/', 'Estabilidad · ~3 min'],
    ],
  },
  {
    title: 'Microbiología y esterilidad',
    description: 'Esterilidad, carga microbiana y endotoxinas son conceptos distintos y se demuestran de maneras distintas.',
    articles: [
      ['Estéril y libre de endotoxinas: ¿significan lo mismo?', '/research-basics/esteril-vs-libre-endotoxinas/', 'Microbiología · ~3 min'],
      ['¿Qué es el bioburden o carga microbiana?', '/research-basics/que-es-bioburden-carga-microbiana/', 'Microbiología · ~3 min'],
      ['¿Qué es una endotoxina bacteriana?', '/research-basics/que-es-endotoxina-bacteriana/', 'Microbiología · ~3 min'],
      ['¿Un filtro esterilizante elimina también las endotoxinas?', '/research-basics/filtro-esterilizante-elimina-endotoxinas/', 'Filtración · ~3 min'],
    ],
  },
  {
    title: 'Agua, diluyentes y conservantes',
    description: 'Materiales transparentes pueden tener composiciones y funciones distintas; la terminología importa.',
    articles: [
      ['Agua estéril y agua bacteriostática: ¿son lo mismo?', '/research-basics/agua-esteril-vs-bacteriostatica/', 'Formulación · ~3 min'],
      ['¿Qué significa realmente “bacteriostático”?', '/research-basics/que-significa-bacteriostatico/', 'Microbiología · ~3 min'],
      ['¿Por qué “bacteriostático” no significa estéril para siempre?', '/research-basics/bacteriostatico-no-significa-esteril-para-siempre/', 'Microbiología · ~3 min'],
      ['¿Qué es el alcohol bencílico y por qué se usa como conservante?', '/research-basics/que-es-alcohol-bencilico-conservante/', 'Excipientes · ~3 min'],
    ],
  },
  {
    title: 'Liofilización y síntesis peptídica',
    description: 'Del aspecto de un liofilizado a cómo se construye y caracteriza un péptido sintético.',
    articles: [
      ['¿Por qué un producto liofilizado parece una “pastilla” o cake?', '/research-basics/por-que-liofilizado-parece-cake/', 'Liofilización · ~3 min'],
      ['¿Qué significa que un liofilizado esté colapsado, agrietado o retraído?', '/research-basics/liofilizado-colapsado-agrietado-retraido/', 'Liofilización · ~3 min'],
      ['¿Un liofilizado tiene que ser siempre blanco?', '/research-basics/liofilizado-siempre-blanco/', 'Liofilización · ~3 min'],
      ['¿Cómo se fabrica un péptido en el laboratorio?', '/research-basics/como-se-fabrica-un-peptido/', 'Química peptídica · ~3 min'],
      ['¿Qué es la síntesis peptídica en fase sólida (SPPS)?', '/research-basics/que-es-spps/', 'Química peptídica · ~3 min'],
      ['¿Qué significa proteger y desproteger un aminoácido?', '/research-basics/proteger-desproteger-aminoacido/', 'Química peptídica · ~3 min'],
      ['¿Por qué fabricar péptidos largos es más difícil?', '/research-basics/por-que-peptidos-largos-son-dificiles/', 'Química peptídica · ~3 min'],
      ['¿Qué es un aminoácido?', '/research-basics/que-es-un-aminoacido/', 'Química básica · ~2 min'],
      ['¿Quién descubrió los aminoácidos y por qué se llaman así?', '/research-basics/quien-descubrio-aminoacidos-por-que-se-llaman-asi/', 'Historia · ~3 min'],
    ],
  },
  {
    title: 'Viales, jeringas y unidades',
    description: 'Piezas básicas para interpretar recipientes, escalas y cantidades sin confundir forma con función.',
    articles: [
      ['Viales: materiales, sistemas de cierre y por qué se elige cada tipo', '/research-basics/viales-materiales-cierres/', 'Envase · ~3 min'],
      ['Cómo se relacionan dosis, concentración, volumen y escala de una jeringa', '/research-basics/dosis-concentracion-volumen-escala-jeringa/', 'Metrología · ~3 min'],
      ['Tipos y escalas de jeringas', '/research-basics/tipos-escalas-jeringas/', 'Dispositivos · ~3 min'],
    ],
  },
];
---

<BaseLayout title="Research Basics" description="Respuestas breves y verificadas sobre laboratorio, analítica, conservación, documentación y ciencia peptídica.">
  <section class="section section--hero">
    <div class="site-frame reading-column">
      <p class="eyebrow">Research Basics</p>
      <h1>Preguntas sencillas. Respuestas claras.</h1>
      <p class="hero__lead">Lecturas cortas para entender los conceptos que aparecen una y otra vez al investigar péptidos, laboratorio y documentación analítica.</p>
    </div>
  </section>
  <section class="section section--quiet"><div class="site-frame cluster-stack">
    {clusters.map((cluster) => (<section class="rb-cluster"><div class="section-heading reading-column"><p class="eyebrow">Research Basics</p><h2>{cluster.title}</h2><p>{cluster.description}</p></div><div class="rb-grid">{cluster.articles.map(([title, href, meta]) => (<a class="rb-card" href={href}><div><p class="surface-kicker">{meta}</p><h3>{title}</h3></div><span aria-hidden="true">→</span></a>))}</div></section>))}
  </div></section>
  <section class="section" aria-labelledby="continue-title">
    <div class="site-frame rb-continuation">
      <div class="reading-column">
        <p class="eyebrow">Más allá de esta lectura</p>
        <h2 id="continue-title">¿Quieres conocer el proyecto detrás de la biblioteca?</h2>
        <p>Research Basics es una superficie educativa. Puedes seguir explorando PeptiBloom sin convertir estos artículos en recomendaciones de producto ni mezclar evidencia científica con información comercial.</p>
      </div>
      <a class="button button--primary" href="/peptibloom/">Explorar PeptiBloom</a>
    </div>
  </section>
</BaseLayout>
<style>.cluster-stack{display:grid;gap:clamp(4rem,8vw,7rem)}.rb-cluster{display:grid;gap:1.5rem}.section-heading>p:last-child{color:var(--color-muted-ink)}.rb-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.rb-card{display:grid;grid-template-columns:1fr auto;gap:1.5rem;align-items:center;padding:clamp(1.25rem,3vw,2rem);border:1px solid var(--color-hairline);border-radius:var(--radius-large);background:var(--color-paper);box-shadow:var(--shadow-paper);color:var(--color-ink);text-decoration:none}.rb-card:hover{border-color:rgba(122,63,104,.35);color:var(--color-ink)}.rb-card h3{font-size:clamp(1.35rem,2.6vw,1.9rem);margin:0}.rb-card>span{color:var(--color-mulberry);font-size:1.6rem}.rb-continuation{display:flex;gap:2rem;align-items:center;justify-content:space-between;padding-top:1rem}.rb-continuation .button{flex:0 0 auto}@media(max-width:760px){.rb-grid{grid-template-columns:1fr}.rb-continuation{align-items:flex-start;flex-direction:column}}</style>