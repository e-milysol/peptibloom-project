---
import BrandLogo from './BrandLogo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-frame site-footer__grid">
    <div>
      <a class="brand brand--footer" href="/" aria-label="PeptiBloom home">
        <BrandLogo class="brand-logo--footer" />
      </a>
      <p class="site-footer__statement">Independent science. Open knowledge. A brighter tomorrow.</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer navigation">
      <a href="/">Home</a>
      <a href="/library/">Library</a>
      <a href="/research-basics/">Research Basics</a>
      <a href="/about/">About</a>
    </nav>

    <div class="site-footer__meta">
      <p>Science today.<br />Real possibilities tomorrow.</p>
      <p>© {year} PeptiBloom</p>
    </div>
  </div>
</footer>

<style>
.site-footer{border-top:1px solid #e8e3ee;background:#fff;color:#2d3154}.site-footer__grid{display:grid;padding-block:1.45rem 1.7rem;grid-template-columns:minmax(16rem,.9fr) minmax(20rem,1fr) minmax(12rem,.52fr);align-items:center;gap:2rem}.brand--footer{display:inline-flex;width:min(100%,13.5rem);margin-bottom:.35rem}.site-footer :global(.brand-logo--footer){width:100%;max-width:none}.site-footer__statement{max-width:28rem;margin:0;color:#4a5073;font-size:.96rem;font-style:italic;line-height:1.45}.site-footer__nav{display:flex;flex-direction:row;flex-wrap:wrap;gap:.9rem 1.2rem;align-items:center;justify-content:center}.site-footer a{color:#30355b}.site-footer__nav a{font-family:var(--font-system);font-size:.82rem;text-decoration:none}.site-footer__nav a:hover{text-decoration:underline}.site-footer__meta{text-align:right;color:#5e6380;font-family:var(--font-system);font-size:.76rem;line-height:1.4}.site-footer__meta p{margin:0 0 .3rem}@media(max-width:760px){.site-footer__grid{grid-template-columns:1fr;align-items:start}.site-footer__meta{text-align:left}.site-footer__nav{justify-content:flex-start;gap:.75rem 1rem}.brand--footer{width:min(100%,12.5rem)}}
</style>
