---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Evidence-First Peptide Research Library"
  description="PeptiBloom is a public peptide research library built around evidence, transparent uncertainty and traceable sources."
>
  <section class="home-hero">
    <div class="home-shell home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">Science today. Clearer knowledge tomorrow.</p>
        <h1>Peptides.<br />Knowledge in <em>Bloom.</em></h1>
        <p class="home-hero__lead">PeptiBloom is an independent, science-driven project built to make peptide evidence, uncertainty and provenance easier to inspect.</p>
        <a class="home-cta" href="/library/">Explore the Library <span aria-hidden="true">→</span></a>
        <div class="home-hero__trust" aria-label="Editorial principles">
          <span><strong>Evidence-based</strong><small>content</small></span>
          <span><strong>Independent</strong><small>and transparent</small></span>
          <span><strong>For researchers</strong><small>and the curious</small></span>
        </div>
      </div>

      <figure class="home-hero__visual">
        <div class="home-hero__art">
          <img src="/brand/editorial/web-assets/hero_home.png" alt="Lavender flower, molecular model and laboratory glassware representing PeptiBloom's scientific editorial identity" />
        </div>
        <figcaption>Small molecules.<br />A bigger tomorrow.</figcaption>
      </figure>
    </div>
  </section>

  <section class="home-explore" aria-labelledby="explore-title">
    <div class="home-shell">
      <div class="home-explore__heading">
        <div>
          <p class="eyebrow">Start here</p>
          <h2 id="explore-title">Three ways to <em>explore</em></h2>
        </div>
        <p>Dive into the science, understand the basics, or browse our curated library.</p>
      </div>

      <div class="home-card-grid">
        <a class="home-card" href="/library/">
          <div class="home-card__visual"><img src="/brand/editorial/web-assets/card_library.png" alt="Books, botanical elements and molecular structure representing the Scientific Library" /></div>
          <div class="home-card__body">
            <h3>Library</h3>
            <p>Explore our growing collection of evidence, reviews and resources on peptides.</p>
            <span>Browse the Library →</span>
          </div>
        </a>

        <a class="home-card" href="/research-basics/">
          <div class="home-card__visual"><img src="/brand/editorial/web-assets/card_research.png" alt="Laboratory pipette, Petri dish and molecular structure representing Research Basics" /></div>
          <div class="home-card__body">
            <h3>Research Basics</h3>
            <p>Clear, visual overviews of recurring concepts, documents and methods around research.</p>
            <span>Start learning →</span>
          </div>
        </a>

        <a class="home-card" href="/about/">
          <div class="home-card__visual"><img src="/brand/editorial/web-assets/card_about.png" alt="Scientific globe, laboratory glassware, DNA and books representing PeptiBloom's wider project" /></div>
          <div class="home-card__body">
            <h3>About PeptiBloom</h3>
            <p>Our mission, principles and why scientific information remains separate from commercial information.</p>
            <span>Learn more →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="home-signoff" aria-label="PeptiBloom editorial statement">
    <div class="home-shell home-signoff__inner">
      <p>Independent science. Open knowledge. <em>A brighter tomorrow.</em></p>
      <span>PeptiBloom</span>
    </div>
  </section>
</BaseLayout>

<style>
.home-shell{width:min(calc(100% - 3rem),92rem);margin-inline:auto}.home-hero{padding:clamp(2.25rem,4vw,4.75rem) 0 2.4rem;background:linear-gradient(180deg,#fff 0%,#fcfafc 100%);overflow:hidden}.home-hero__grid{display:grid;grid-template-columns:minmax(25rem,.82fr) minmax(34rem,1.18fr);align-items:center;gap:clamp(1.5rem,3.5vw,4rem)}.home-hero__copy{position:relative;z-index:2;padding-block:1rem}.home-hero__copy .eyebrow{margin-bottom:1.2rem;color:var(--color-lavender-deep);letter-spacing:.19em}.home-hero__copy h1{max-width:8.3ch;margin:0 0 1.1rem;font-size:clamp(3.45rem,5.55vw,5.9rem);line-height:.9;letter-spacing:-.055em;font-weight:500}.home-hero__copy h1 em{color:#5f4cc4;font-weight:400}.home-hero__lead{max-width:34rem;margin:0 0 1.45rem;color:#3f435f;font-size:clamp(1.06rem,1.45vw,1.32rem);line-height:1.43}.home-cta{display:inline-flex;align-items:center;gap:1.1rem;min-height:3.25rem;padding:.83rem 1.55rem;border-radius:999px;background:linear-gradient(135deg,#6046c8,#7a56d4);color:#fff;font-family:var(--font-system);font-size:1rem;font-weight:500;text-decoration:none;box-shadow:0 .55rem 1.25rem rgba(96,70,200,.2)}.home-cta:hover{color:#fff;transform:translateY(-1px)}.home-hero__trust{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;max-width:38rem;margin-top:1.5rem;padding-top:1.15rem;border-top:1px solid #ece8f1}.home-hero__trust span{display:grid;gap:.05rem;padding-left:2.1rem;position:relative;font-family:var(--font-system)}.home-hero__trust span::before{content:"";position:absolute;left:0;top:.1rem;width:1.35rem;height:1.35rem;border:1.5px solid #6655c8;border-radius:.35rem}.home-hero__trust strong{font-size:.84rem;color:#2c3152}.home-hero__trust small{font-size:.76rem;line-height:1.3;color:#6a6d82}.home-hero__visual{position:relative;margin:0;min-height:clamp(27rem,39vw,39rem);display:flex;align-items:center}.home-hero__art{position:absolute;inset:0;border-radius:0;background:radial-gradient(circle at 58% 48%,rgba(196,181,255,.34),transparent 31%),radial-gradient(circle at 83% 46%,rgba(207,232,219,.22),transparent 34%),linear-gradient(90deg,rgba(255,255,255,0) 0%,rgba(245,242,251,.88) 26%,rgba(239,236,249,.95) 100%)}.home-hero__art img{position:absolute;right:-8%;bottom:-1%;width:112%;max-width:none;filter:drop-shadow(0 28px 28px rgba(73,54,98,.16))}.home-hero__visual figcaption{position:absolute;right:2.2rem;top:3rem;z-index:2;max-width:10rem;color:#fff;font-size:clamp(1.15rem,1.8vw,1.55rem);font-style:italic;line-height:1.28;text-shadow:0 2px 10px rgba(44,37,73,.35)}

.home-explore{padding:2.65rem 0 3.1rem;background:#fff;border-top:1px solid #eeeaf2}.home-explore__heading{display:grid;grid-template-columns:minmax(0,.9fr) minmax(18rem,.62fr);gap:2rem;align-items:end;margin-bottom:1.35rem}.home-explore__heading .eyebrow{margin-bottom:.3rem;color:var(--color-lavender-deep)}.home-explore__heading h2{margin:0;font-size:clamp(2.35rem,3.9vw,4rem);line-height:.96}.home-explore__heading h2 em{color:#5f4cc4;font-weight:400}.home-explore__heading>p{max-width:29rem;margin:0;color:#4d526e;font-size:1.08rem;line-height:1.45}.home-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem}.home-card{display:grid;grid-template-rows:13.5rem 1fr;overflow:hidden;border:1px solid #e9e5ee;border-radius:1rem;background:#fff;color:var(--color-ink);text-decoration:none;box-shadow:0 .45rem 1.5rem rgba(61,49,83,.07);transition:transform .18s ease,box-shadow .18s ease}.home-card:hover{transform:translateY(-3px);box-shadow:0 .8rem 1.9rem rgba(61,49,83,.11);color:var(--color-ink)}.home-card__visual{display:flex;align-items:flex-end;justify-content:center;overflow:hidden;background:linear-gradient(150deg,#f5f2fb,#eee9f7)}.home-card__visual img{width:108%;height:108%;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 14px 16px rgba(67,53,91,.12))}.home-card__body{display:flex;flex-direction:column;min-height:11.2rem;padding:1.05rem 1.15rem 1.1rem}.home-card h3{margin:0 0 .35rem;font-size:1.35rem;line-height:1.1}.home-card p{margin:0 0 .8rem;color:#505470;font-family:var(--font-system);font-size:.9rem;line-height:1.4}.home-card span{margin-top:auto;color:#5f4cc4;font-family:var(--font-system);font-size:.88rem;font-weight:500}.home-signoff{padding:2.2rem 0;background:linear-gradient(90deg,#f0ecfb,#f8f6fc 48%,#efeafa);border-top:1px solid #e7e1ef}.home-signoff__inner{display:flex;align-items:center;justify-content:space-between;gap:2rem}.home-signoff p{margin:0;color:#343a65;font-size:1.24rem}.home-signoff em{color:#5f4cc4}.home-signoff span{font-family:var(--font-system);font-size:.9rem;letter-spacing:.1em;color:#454b72}

@media(max-width:980px){.home-hero__grid{grid-template-columns:1fr}.home-hero__copy h1{max-width:11ch}.home-hero__visual{min-height:31rem}.home-hero__art img{right:-4%;width:100%}.home-explore__heading{grid-template-columns:1fr}.home-card-grid{grid-template-columns:1fr 1fr}.home-card:last-child{grid-column:1/-1}}
@media(max-width:640px){.home-shell{width:min(calc(100% - 2rem),92rem)}.home-hero{padding-top:1.5rem}.home-hero__copy h1{font-size:clamp(3rem,15vw,4.8rem)}.home-hero__trust{grid-template-columns:1fr}.home-hero__visual{min-height:23rem}.home-hero__art img{right:-18%;width:132%}.home-hero__visual figcaption{top:1.2rem;right:1rem;font-size:1rem}.home-card-grid{grid-template-columns:1fr}.home-card:last-child{grid-column:auto}.home-signoff__inner{align-items:flex-start;flex-direction:column}.home-signoff p{font-size:1.05rem}}
</style>
