---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-frame site-footer__grid">
    <div>
      <a class="brand brand--footer brand--official" href="/" aria-label="PeptiBloom home">
        <img
          class="brand__official-logo"
          src="/brand/logo.png"
          alt="PeptiBloom"
          width="1536"
          height="1024"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="site-footer__statement">
        A scientific research library built around evidence, transparency and traceability.
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer navigation">
      <a href="/library/">Scientific Library</a>
      <a href="/methodology/">Methodology</a>
      <a href="/about/">About &amp; transparency</a>
    </nav>

    <div class="site-footer__meta">
      <p>The Scientific Library is a PeptiBloom initiative.</p>
      <p>Evidence · Transparency · Traceability</p>
      <p>© {year} PeptiBloom</p>
    </div>
  </div>
</footer>

<style>
  .brand--official {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  .brand__official-logo {
    width: clamp(8rem, 12vw, 10.5rem);
    height: 3rem;
    object-fit: contain;
    object-position: left center;
  }

  .brand--footer .brand__official-logo {
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }
</style>
