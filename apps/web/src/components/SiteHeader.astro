---
const pathname = Astro.url.pathname;

const navigation = [
  { href: '/library/', label: 'Library' },
  { href: '/methodology/', label: 'Methodology' },
  { href: '/about/', label: 'About' },
];

const isCurrent = (href: string) => pathname.startsWith(href);
---

<header class="site-header">
  <div class="site-frame site-header__inner">
    <a class="brand" href="/" aria-label="PeptiBloom home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" focusable="false">
          <circle cx="20" cy="20" r="14" pathLength="100"></circle>
          <circle cx="20" cy="20" r="8" pathLength="100"></circle>
          <circle class="brand-mark__node" cx="29" cy="10" r="2"></circle>
        </svg>
      </span>
      <span class="brand__name">PeptiBloom</span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      <ul>
        {navigation.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
