---
const pathname = Astro.url.pathname;

const navigation = [
  { href: '/library/', label: 'Library' },
  { href: '/methodology/', label: 'Methodology' },
  { href: '/about/', label: 'About' },
];

const isCurrent = (href: string) => pathname.startsWith(href);
---

<header class="site-header">
  <div class="site-frame site-header__inner">
    <a class="brand brand--official" href="/" aria-label="PeptiBloom home">
      <img
        class="brand__official-logo"
        src="/brand/logo.png"
        alt="PeptiBloom"
        width="1536"
        height="1024"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      <ul>
        {navigation.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .brand--official {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  .brand__official-logo {
    width: clamp(7.5rem, 11vw, 10rem);
    height: 2.8rem;
    object-fit: contain;
    object-position: left center;
  }
</style>
