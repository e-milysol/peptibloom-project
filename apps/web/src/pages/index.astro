---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Evidence-First Peptide Research Library"
  description="PeptiBloom is a public peptide research library built around evidence, transparent uncertainty and traceable sources."
>
  <section class="home-hero">
    <div class="home-shell home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">Science today. Clearer knowledge tomorrow.</p>
        <h1>Peptides.<br />Knowledge in <em>Bloom.</em></h1>
        <p class="home-hero__lead">PeptiBloom is an independent, science-driven project built to make peptide evidence, uncertainty and provenance easier to inspect.</p>
        <a class="home-cta" href="/library/">Explore the Library <span aria-hidden="true">→</span></a>
        <div class="home-hero__trust" aria-label="Editorial principles">
          <span><strong>Evidence-based</strong><small>content</small></span>
          <span><strong>Independent</strong><small>and transparent</small></span>
          <span><strong>For researchers</strong><small>and the curious</small></span>
        </div>
      </div>

      <figure class="home-hero__visual">
        <div class="home-hero__art">
          <img src="/brand/editorial/web-assets/hero_home.png" alt="Lavender flower, molecular model and laboratory glassware representing PeptiBloom's scientific editorial identity" />
        </div>
        <figcaption>Small molecules.<br />A bigger tomorrow.</figcaption>
      </figure>
    </div>
  </section>

  <section class="home-explore" aria-labelledby="explore-title">
    <div class="home-shell">
      <div class="home-explore__heading">
        <div>
          <p class="eyebrow">Start here</p>
          <h2 id="explore-title">Three ways to <em>explore</em></h2>
        </div>
        <p>Dive into the science, understand the basics, or browse our curated library.</p>
      </div>

      <div class="home-card-grid">
        <a class="home-card" href="/library/">
          <div class="home-card__visual"><img src="/brand/editorial/web-assets/card_library.png" alt="Books, botanical elements and molecular structure representing the Scientific Library" /></div>
          <div class="home-card__body">
            <h3>Library</h3>
            <p>Explore our growing collection of evidence, reviews and resources on peptides.</p>
            <span>Browse the Library →</span>
          </div>
        </a>

        <a class="home-card" href="/research-basics/">
          <div class="home-card__visual"><img src="/brand/editorial/web-assets/card_research.png" alt="Laboratory pipette, Petri dish and molecular structure representing Research Basics" /></div>
          <div class="home-card__body">
            <h3>Research Basics</h3>
            <p>Clear, visual overviews of recurring concepts, documents and methods around research.</p>
            <span>Start learning →</span>
          </div>
        </a>

        <a class="home-card" href="/about/">
          <div class="home-card__visual"><img src="/brand/editorial/web-assets/card_about.png" alt="Scientific globe, laboratory glassware, DNA and books representing PeptiBloom's wider project" /></div>
          <div class="home-card__body">
            <h3>About PeptiBloom</h3>
            <p>Our mission, principles and why scientific information remains separate from commercial information.</p>
            <span>Learn more →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="home-signoff" aria-label="PeptiBloom editorial statement">
    <div class="home-shell home-signoff__inner">
      <p>Independent science. Open knowledge. <em>A brighter tomorrow.</em></p>
      <span>PeptiBloom</span>
    </div>
  </section>
</BaseLayout>

<style>
.home-shell{width:min(calc(100% - 3rem),92rem);margin-inline:auto}.home-hero{padding:clamp(1.5rem,3vw,3.2rem) 0 1.9rem;background:linear-gradient(180deg,#fff 0%,#fcfafc 100%);overflow:hidden}.home-hero__grid{display:grid;grid-template-columns:minmax(24rem,.78fr) minmax(34rem,1.22fr);align-items:center;gap:clamp(1.25rem,3vw,3.2rem)}.home-hero__copy{position:relative;z-index:2;padding-block:.5rem}.home-hero__copy .eyebrow{margin-bottom:1rem;color:var(--color-lavender-deep);letter-spacing:.19em}.home-hero__copy h1{max-width:8.3ch;margin:0 0 1rem;font-size:clamp(3.35rem,5.25vw,5.65rem);line-height:.9;letter-spacing:-.055em;font-weight:500}.home-hero__copy h1 em{color:#5f4cc4;font-weight:400}.home-hero__lead{max-width:33rem;margin:0 0 1.25rem;color:#3f435f;font-size:clamp(1.02rem,1.35vw,1.24rem);line-height:1.42}.home-cta{display:inline-flex;align-items:center;gap:1.1rem;min-height:3.15rem;padding:.78rem 1.5rem;border-radius:999px;background:linear-gradient(135deg,#6046c8,#7a56d4);color:#fff;font-family:var(--font-system);font-size:.98rem;font-weight:500;text-decoration:none;box-shadow:0 .55rem 1.25rem rgba(96,70,200,.2)}.home-cta:hover{color:#fff;transform:translateY(-1px)}.home-hero__trust{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.85rem;max-width:36rem;margin-top:1.2rem;padding-top:1rem;border-top:1px solid #ece8f1}.home-hero__trust span{display:grid;gap:.04rem;padding-left:1.9rem;position:relative;font-family:var(--font-system)}.home-hero__trust span::before{content:"";position:absolute;left:0;top:.08rem;width:1.25rem;height:1.25rem;border:1.5px solid #6655c8;border-radius:.35rem}.home-hero__trust strong{font-size:.8rem;color:#2c3152}.home-hero__trust small{font-size:.73rem;line-height:1.28;color:#6a6d82}.home-hero__visual{position:relative;margin:0;min-height:clamp(24rem,34vw,34rem);display:flex;align-items:center}.home-hero__art{position:absolute;inset:0;background:radial-gradient(circle at 58% 43%,rgba(196,181,255,.36),transparent 31%),radial-gradient(circle at 82% 43%,rgba(207,232,219,.24),transparent 34%),linear-gradient(90deg,rgba(255,255,255,0) 0%,rgba(245,242,251,.88) 23%,rgba(239,236,249,.96) 100%)}.home-hero__art img{position:absolute;right:-5%;bottom:1.8%;width:108%;max-width:none;filter:drop-shadow(0 22px 24px rgba(73,54,98,.15))}.home-hero__visual figcaption{position:absolute;right:2.45rem;top:2rem;z-index:2;max-width:10rem;color:#fff;font-size:clamp(1.05rem,1.65vw,1.4rem);font-style:italic;line-height:1.28;text-shadow:0 2px 10px rgba(44,37,73,.35)}

.home-explore{padding:2.35rem 0 2.8rem;background:#fff;border-top:1px solid #eeeaf2}.home-explore__heading{display:grid;grid-template-columns:minmax(0,.9fr) minmax(18rem,.62fr);gap:2rem;align-items:end;margin-bottom:1.2rem}.home-explore__heading .eyebrow{margin-bottom:.28rem;color:var(--color-lavender-deep)}.home-explore__heading h2{margin:0;font-size:clamp(2.25rem,3.7vw,3.8rem);line-height:.96}.home-explore__heading h2 em{color:#5f4cc4;font-weight:400}.home-explore__heading>p{max-width:28rem;margin:0;color:#4d526e;font-size:1.03rem;line-height:1.42}.home-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.1rem}.home-card{display:grid;grid-template-rows:12.8rem minmax(10.8rem,1fr);overflow:hidden;border:1px solid #e9e5ee;border-radius:1rem;background:#fff;color:var(--color-ink);text-decoration:none;box-shadow:0 .45rem 1.5rem rgba(61,49,83,.07);transition:transform .18s ease,box-shadow .18s ease}.home-card:hover{transform:translateY(-3px);box-shadow:0 .8rem 1.9rem rgba(61,49,83,.11);color:var(--color-ink)}.home-card__visual{display:flex;align-items:flex-end;justify-content:center;overflow:hidden;border-bottom:1px solid rgba(102,85,142,.08);background:radial-gradient(circle at 56% 38%,rgba(199,182,255,.26),transparent 36%),linear-gradient(150deg,#f7f4fc,#eee9f7)}.home-card__visual img{width:106%;height:106%;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 12px 15px rgba(67,53,91,.12))}.home-card__body{display:flex;flex-direction:column;min-height:10.8rem;padding:1rem 1.12rem 1.05rem}.home-card h3{margin:0 0 .32rem;font-size:1.3rem;line-height:1.08}.home-card p{margin:0 0 .72rem;color:#505470;font-family:var(--font-system);font-size:.88rem;line-height:1.38}.home-card span{margin-top:auto;color:#5f4cc4;font-family:var(--font-system);font-size:.86rem;font-weight:500}.home-signoff{padding:1.95rem 0;background:linear-gradient(90deg,#f0ecfb,#f8f6fc 48%,#efeafa);border-top:1px solid #e7e1ef}.home-signoff__inner{display:flex;align-items:center;justify-content:space-between;gap:2rem}.home-signoff p{margin:0;color:#343a65;font-size:1.16rem}.home-signoff em{color:#5f4cc4}.home-signoff span{font-family:var(--font-system);font-size:.88rem;letter-spacing:.1em;color:#454b72}

@media(max-width:980px){.home-hero__grid{grid-template-columns:1fr}.home-hero__copy h1{max-width:11ch}.home-hero__visual{min-height:28rem}.home-hero__art img{right:-2%;bottom:1%;width:98%}.home-explore__heading{grid-template-columns:1fr}.home-card-grid{grid-template-columns:1fr 1fr}.home-card:last-child{grid-column:1/-1}}
@media(max-width:640px){.home-shell{width:min(calc(100% - 2rem),92rem)}.home-hero{padding-top:1.25rem}.home-hero__copy h1{font-size:clamp(3rem,15vw,4.8rem)}.home-hero__trust{grid-template-columns:1fr}.home-hero__visual{min-height:21rem}.home-hero__art img{right:-15%;width:128%}.home-hero__visual figcaption{top:1rem;right:.9rem;font-size:.96rem}.home-card-grid{grid-template-columns:1fr}.home-card:last-child{grid-column:auto}.home-signoff__inner{align-items:flex-start;flex-direction:column}.home-signoff p{font-size:1.02rem}}
</style>
